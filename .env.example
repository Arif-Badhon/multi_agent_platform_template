# ==============================================================================
# Voice AI Multi-Agent Platform - Environment Configuration Template
# ==============================================================================
#
# Copy this file to '.env' and fill in your secrets and configuration:
#   $ cp .env.example .env
#
# This file is loaded by both the Pydantic Settings core service in python
# and Docker Compose during deployment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API & Core Application Settings
# ------------------------------------------------------------------------------
DEBUG=true
HOST=0.0.0.0
PORT=8000
API_TITLE="Voice AI Agent API"
API_VERSION="1.0.0"

# CORS Allowed Origins (JSON array format)
CORS_ORIGINS=["*"]

# ------------------------------------------------------------------------------
# 2. Security & Authentication (Critical)
# ------------------------------------------------------------------------------
# API Key secret required for secure WebSocket connection validation (X-API-Key header)
API_KEY_SECRET="your-secure-websocket-api-key-here"

# ------------------------------------------------------------------------------
# 3. LangGraph & Ollama (Local LLM Configuration)
# ------------------------------------------------------------------------------
# Base URL for local Ollama server (e.g. http://localhost:11434 on host, http://ollama:11434 inside docker)
OLLAMA_BASE_URL="http://localhost:11434"

# Local LLM Model to pull and run via Ollama (e.g., llama3.2, llama3.1, mistral)
LLM_MODEL="llama3.2"

# LLM Temperature (0.0 for strict deterministic tool usage, higher for creative responses)
LLM_TEMPERATURE=0.0

# ------------------------------------------------------------------------------
# 4. Storage & State Persistence Layers
# ------------------------------------------------------------------------------
# Qdrant Vector DB Location: Use ":memory:" for fast local memory tests, or Qdrant URL for production
QDRANT_LOCATION="http://localhost:6333"
QDRANT_COLLECTION="voice_ai_docs"

# Redis Cache and checkpointer URL
REDIS_URL="redis://localhost:6379/0"

# ------------------------------------------------------------------------------
# 5. External Cloud Integrations (Optional / Services)
# ------------------------------------------------------------------------------
# Cartesia API Key (High-performance Text-to-Speech backend)
# Sign up at: https://play.cartesia.ai/
CARTESIA_API_KEY=""

# Langfuse Observability Keys (Agent tracing, evaluation, and logging)
# Sign up or self-host: https://langfuse.com/
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
